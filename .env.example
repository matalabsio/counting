# Admin password for /admin (Bearer or ?token=). Required on Render (API host).
# Local: copy to .env.local and restart `npm run dev`
COUNTING_WRITE_TOKEN=admincounting123

# Optional — SQLite path (Render disk: /var/data/counting.db)
# COUNTING_DB_PATH=./data/counting.db

# Vercel frontend only — proxy /api/* to the Render app (no trailing slash)
# COUNTING_API_UPSTREAM=https://counting-day.onrender.com
